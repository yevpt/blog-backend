# Docker 敏感变量模板
# 复制为 .env 并填写真实值（.env 已加入 .gitignore，不会提交到 git）
# CI 部署时会按分支注入 APP_ENV / COMPOSE_CONTAINER_NAME，一般无需在 .env 中重复设置

# 运行环境（可选，CI 按分支覆盖：main=prod，dev=test）
# APP_ENV=prod
# COMPOSE_CONTAINER_NAME=blog-server

# MySQL（生产/测试环境通常由宝塔或独立实例提供）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=blog_prod
DB_USER=blog
DB_PASSWORD=change_me_db_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# JWT 签名密钥（生产环境务必使用长随机字符串）
JWT_SECRET=change_me_jwt_secret_use_long_random_string

# Garage 对象存储
STORAGE_ENDPOINT=http://your-garage-server:3900
STORAGE_BUCKET=blog
STORAGE_REGION=garage
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_CDN=false

CDN_HOST=http://your-cdn-domain
CDN_SECRET=your_cdn_secret
CDN_SIGN_QUERY_NAME=a
CDN_TIMESTAMP_QUERY_NAME=b

# 服务端口（可选，默认 8080）
SERVER_PORT=8080

# 站点分析
# 允许上报的前台来源（精确全等，含 https://，多个逗号分隔，列全 www 与裸域、勿含 admin）
ANALYTICS_ALLOWED_ORIGINS=https://www.example.com,https://example.com
# 站点主域名（apex 顶级域，勿填 www；后缀匹配自动覆盖子域名），用于 referer 内/外链判定
ANALYTICS_SITE_HOST=example.com
ANALYTICS_GEOIP_V4_PATH=/app/geoip/ip2region_v4.xdb
ANALYTICS_GEOIP_V6_PATH=/app/geoip/ip2region_v6.xdb
ANALYTICS_IP_SALT=change_me_random_string
# collect 上报签名 token 的 HMAC secret（反伪造）。
# 须与前端 apps/web 的 ANALYTICS_COLLECT_TOKEN_SECRET 设为完全相同的值（变量名不同、密钥相同）。
# 留空 = 关闭 token 校验（后端放行、前端不签发）；要么两边都设、要么两边都空，切忌只设一边。
ANALYTICS_COLLECT_TOKEN_SECRET=
